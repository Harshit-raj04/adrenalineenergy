# ── Adrenaline Backend Environment Configuration ──
PORT=5000
NODE_ENV=development

# MongoDB Connection String (e.g. local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/adrenaline

# Redis Cache URL & Switch (Optional: in-memory fallback engages automatically if offline)
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=false

# JSON Web Token Secret Key
JWT_SECRET=super_secret_adrenaline_key_2026

# Administrator Access PIN
ADMIN_PIN=2004

# Optional: Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_secret_placeholder_key
